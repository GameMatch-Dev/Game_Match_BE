# Do not commit a real .env file. Copy these names into your local environment.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
FRONTEND_LOGIN_REDIRECT_URI=http://localhost:3000/login/callback
# 여러 프런트 주소는 쉼표로 구분한다. '*'은 사용하지 않는다.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# 기본값이 없으므로 개발 환경에서도 임의의 긴 비밀값을 직접 설정한다.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=gamematch
